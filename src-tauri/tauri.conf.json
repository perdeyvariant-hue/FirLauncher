{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FirLauncher",
  "version": "0.3.1",
  "identifier": "dev.firlauncher.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FirLauncher",
        "width": 1280,
        "height": 800,
        "minWidth": 940,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "visible": false,
        "theme": "Dark",
        "backgroundColor": "#0A0A0B"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Game",
    "shortDescription": "Minecraft instance launcher",
    "longDescription": "FirLauncher manages isolated Minecraft instances, mod loaders and mods.",
    "publisher": "FirLauncher contributors",
    "copyright": "© 2026 FirLauncher contributors. MIT License.",
    "homepage": "https://github.com/perdeyvariant-hue/FirLauncher",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      },
      "wix": {
        "language": "en-US"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI1MUE5NzhBMTMwMjE2RjEKUldUeEZnSVRpcGNhSllUeWhQQkUweFJFSnhnbDRNbGRUYTFkYUtlWmRwVFVyS1l0U0o3VWJCaTEK",
      "endpoints": [
        "https://github.com/perdeyvariant-hue/FirLauncher/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
